;===================================================
[dexter]
exten => _X.,1,Set(CALLFILENAME=${EXTEN}-${CALLERID(num)}-${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)})
  same => n,GoToIf($["${DB(DND/${EXTEN})}" = "on" ]?busy,${EXTEN},1)
 
  same => n,GoToIf($["${RECORD_${CALLERID(num)}}" = "out"]?recording,${EXTEN},1)
  same => n,GoToIf($["${RECORD_${EXTEN}}" = "out"]?recording,${EXTEN},1)
  same => n,GoToIf($["${RECORD_${EXTEN}}" = "in"]?recording,${EXTEN},1)
  same => n,GotoIf($[ "${RECORD_${CALLERID(num)}}" = "all" || "${RECORD_${EXTEN}}" = "all" ]?recording,${EXTEN},1)
  same => n,Dial(${PJSIP_DIAL_CONTACTS(${EXTEN})},30,TtHh)


exten => 3000,1,Answer()
;same => n,SayDigits(${EXTEN})
same => n,playback(de-activated)
;same => n,playback(pbx-invalid) this is invalid extention 
 same => n,playback(is-curntly-unavail,noanswer) 
;same => n,playback()
same => n,GoTo(internal,2222,1)

;==========================QUEUE===================================


[queue]
exten => 7000,1,Answer()
;same => n,Playback(RAFIK_Queuee)
same => n,Set(CALLERID(name)= SUPPORT)
same => n,Queue(support,tT,,,20)
same => n,Playback(vm-nobodyavail)     ;dectnation if no one answer
same => n,Hangup()


