exten => 7000,1,Answer()
 same => n,Mset(test=1,cuc=1)
 same => n(hamo),Background(CUC-Welcome_new)
 same => n,WaitExten(3)
exten => 1,1,GoTo(internal,2222,1)
exten => 2,1,Goto(internal,7001,1)

