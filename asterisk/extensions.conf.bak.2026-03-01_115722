[recording]
exten => _X.,1,set(dex=$[${dex} + 1])
  same => n,GotoIf($[${dex} > 2]?tit) 
  same => n,MixMonitor(/var/spool/asterisk/monitor/${CALLFILENAME}.wav,b)
  same => n(tit),Dial(${PJSIP_DIAL_CONTACTS(${EXTEN})},20,TtHh)
  same => n,FollowMe(${EXTEN})


same => n,GotoIf($["${DIALSTATUS}" = "BUSY"        & "${VM_${EXTEN}}" = "off"]?forward-busy,${EXTEN},1)
same => n,GotoIf($["${DIALSTATUS}" = "BUSY"        & "${VM_${EXTEN}}" = "on"]?vm,${EXTEN},1)

same => n,GotoIf($["${DIALSTATUS}" = "NOANSWER"    & "${VM_${EXTEN}}" = "off"]?forward-noanswer,${EXTEN},1)
same => n,GotoIf($["${DIALSTATUS}" = "NOANSWER"    & "${VM_${EXTEN}}" = "on"]?vm,${EXTEN},1)

same => n,GotoIf($["${DIALSTATUS}" = "CHANUNAVAIL" & "${VM_${EXTEN}}" = "off"]?forward-unavail,${EXTEN},1)
same => n,GotoIf($["${DIALSTATUS}" = "CHANUNAVAIL" & "${VM_${EXTEN}}" = "on"]?vm,${EXTEN},1)


